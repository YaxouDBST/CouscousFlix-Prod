{
  "manifest_version": 3,
  "name": "YaxouDBST Proxy Extension",
  "version": "1.3.9",
  "description": "Extension proxy pour Live TV YaxouDBST - Contourne CORS, injecte les headers et extrait les sources Nexus",
  "icons": {
    "16": "yaxoudbst.png",
    "48": "yaxoudbst.png",
    "128": "yaxoudbst.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "yaxoudbst.png",
      "48": "yaxoudbst.png",
      "128": "yaxoudbst.png"
    },
    "default_title": "YaxouDBST Extension"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "host_permissions": ["<all_urls>", "http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": [
      "*://localhost/*",
      "*://yaxoudbst.cash/*",
      "*://*.yaxoudbst.cash/*",
      "*://yaxoudbst.cloud/*",
      "*://*.yaxoudbst.cloud/*",
      "*://yaxoudbst.tax/*",
      "*://*.yaxoudbst.tax/*",
      "*://yaxoudbst.club/*",
      "*://*.yaxoudbst.club/*",
      "*://yaxoudbst.golf/*",
      "*://*.yaxoudbst.golf/*",
      "*://yaxoudbst.chat/*",
      "*://*.yaxoudbst.chat/*",
      "*://yaxoudbst.date/*",
      "*://*.yaxoudbst.date/*",
      "*://yaxoudbst.show/*",
      "*://*.yaxoudbst.show/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content.js",
        "injected.js",
        "extractors.js",
        "popup.html",
        "popup.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
