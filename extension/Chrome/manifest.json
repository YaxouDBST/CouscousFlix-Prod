{
  "manifest_version": 3,
  "name": "CouscousFlix Proxy Extension",
  "version": "1.3.9",
  "description": "Extension proxy pour Live TV CouscousFlix - Contourne CORS, injecte les headers et extrait les sources Nexus",
  "icons": {
    "16": "couscousflix.png",
    "48": "couscousflix.png",
    "128": "couscousflix.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "couscousflix.png",
      "48": "couscousflix.png",
      "128": "couscousflix.png"
    },
    "default_title": "CouscousFlix Extension"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "host_permissions": ["<all_urls>", "http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": [
      "*://localhost/*",
      "*://couscousflix.cash/*",
      "*://*.couscousflix.cash/*",
      "*://couscousflix.cloud/*",
      "*://*.couscousflix.cloud/*",
      "*://couscousflix.tax/*",
      "*://*.couscousflix.tax/*",
      "*://couscousflix.club/*",
      "*://*.couscousflix.club/*",
      "*://couscousflix.golf/*",
      "*://*.couscousflix.golf/*",
      "*://couscousflix.chat/*",
      "*://*.couscousflix.chat/*",
      "*://couscousflix.date/*",
      "*://*.couscousflix.date/*",
      "*://couscousflix.show/*",
      "*://*.couscousflix.show/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content.js",
        "injected.js",
        "extractors.js",
        "popup.html",
        "popup.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
